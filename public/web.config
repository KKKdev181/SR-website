<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Technology Delivery AI Gateway" stopProcessing="true">
          <match url="^api/ai/(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:8084/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
